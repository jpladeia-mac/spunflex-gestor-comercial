# ============================================================
# SPUNFLEX SERVER - EXEMPLO DE CONFIGURAÇÃO
# ============================================================
# Copie este arquivo para .env e preencha com seus valores

PORT=3000
NODE_ENV=development
JWT_SECRET=seu-jwt-secret-aleatorio-long-string
SESSION_MAX_AGE_MINUTES=480
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MS=900000
REQUIRE_HTTPS=false
